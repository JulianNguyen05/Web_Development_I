@model ThiGK65CNTTCLC_65133958.Models.HOCVIEN

@{
    ViewBag.Title = "Thêm mới Học viên";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    .form-card {
        background: #ffffff;
        border-radius: 12px;
        box-shadow: var(--shadow);
        padding: 30px;
        border-top: 5px solid var(--primary);
        max-width: 800px;
        margin: 20px auto;
    }

        .form-card h2 {
            text-align: center;
            color: var(--bg-dark);
            margin-bottom: 30px;
            font-weight: 600;
        }

    .form-row {
        display: grid;
        grid-template-columns: 150px 1fr;
        gap: 15px;
        align-items: center;
        margin-bottom: 20px;
    }

    .form-label {
        font-weight: 600;
        color: #555;
        text-align: right;
    }

    .form-control {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid #ccc;
        border-radius: 6px;
        font-size: 1rem;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .form-control:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(78, 115, 223, 0.25);
            outline: none;
        }

    .radio-group {
        display: flex;
        gap: 25px;
        align-items: center;
    }

        .radio-group label {
            font-weight: 500;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .radio-group input[type="radio"] {
            width: 16px;
            height: 16px;
        }

    .submit-row {
        grid-column: 1 / -1;
        text-align: center;
        margin-top: 20px;
    }

    .btn-submit {
        background: var(--primary);
        color: #fff;
        padding: 12px 30px;
        border: none;
        border-radius: 8px;
        font-size: 1.1rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.3s ease;
    }

        .btn-submit:hover {
            background: var(--primary-hover);
        }

    .text-danger {
        color: #e74a3b;
        font-size: 0.9rem;
        grid-column: 2 / -1;
        margin-top: -15px;
        margin-bottom: 5px;
    }
</style>

<div class="form-card">
    <h2>NHẬP THÔNG TIN HỌC VIÊN</h2>

    @using (Html.BeginForm("Create_65133958", "HOCVIENs_65133958", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()

        <div class="form-row">
            @Html.LabelFor(model => model.MaHV, "Mã học viên", new { @class = "form-label" })
            @Html.EditorFor(model => model.MaHV, new { htmlAttributes = new { @class = "form-control" } })
        </div>
        @Html.ValidationMessageFor(model => model.MaHV, "", new { @class = "text-danger" })

        <div class="form-row">
            @Html.LabelFor(model => model.HoHV, "Họ học viên", new { @class = "form-label" })
            @Html.EditorFor(model => model.HoHV, new { htmlAttributes = new { @class = "form-control" } })
        </div>
        @Html.ValidationMessageFor(model => model.HoHV, "", new { @class = "text-danger" })

        <div class="form-row">
            @Html.LabelFor(model => model.TenHV, "Tên học viên", new { @class = "form-label" })
            @Html.EditorFor(model => model.TenHV, new { htmlAttributes = new { @class = "form-control" } })
        </div>
        @Html.ValidationMessageFor(model => model.TenHV, "", new { @class = "text-danger" })

        <div class="form-row">
            <label class="form-label" for="AnhUpload">Ảnh đại diện</label>
            <input type="file" name="AnhUpload" id="AnhUpload" class="form-control" />
        </div>
        @Html.ValidationMessageFor(model => model.AnhDaiDien, "", new { @class = "text-danger" })

        <div class="form-row">
            @Html.LabelFor(model => model.NgaySinh, "Ngày sinh", new { @class = "form-label" })
            @Html.EditorFor(model => model.NgaySinh, new { htmlAttributes = new { @class = "form-control", @type = "date" } })
        </div>
        @Html.ValidationMessageFor(model => model.NgaySinh, "", new { @class = "text-danger" })

        <div class="form-row">
            @Html.LabelFor(model => model.GioiTinh, "Giới tính", new { @class = "form-label" })
            <div class="radio-group">
                <label>
                    @Html.RadioButtonFor(model => model.GioiTinh, "true", new { @checked = "checked" })
                    <span>Nam</span>
                </label>
                <label>
                    @Html.RadioButtonFor(model => model.GioiTinh, "false")
                    <span>Nữ</span>
                </label>
            </div>
        </div>
        @Html.ValidationMessageFor(model => model.GioiTinh, "", new { @class = "text-danger" })

        <div class="form-row">
            @Html.LabelFor(model => model.Email, "Email", new { @class = "form-label" })
            @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control", @type = "email" } })
        </div>
        @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })


        <div class="form-row">
            @Html.LabelFor(model => model.DiaChi, "Địa chỉ", new { @class = "form-label" })
            @Html.EditorFor(model => model.DiaChi, new { htmlAttributes = new { @class = "form-control" } })
        </div>
        @Html.ValidationMessageFor(model => model.DiaChi, "", new { @class = "text-danger" })

        <div class="form-row">
            @Html.LabelFor(model => model.MaDoiTuong, "Đối tượng", new { @class = "form-label" })
            @Html.DropDownList("MaDoiTuong", null, "--- Chọn đối tượng ---", htmlAttributes: new { @class = "form-control" })
        </div>
        @Html.ValidationMessageFor(model => model.MaDoiTuong, "", new { @class = "text-danger" })

        <div class="form-row submit-row">
            <input type="submit" value="Thêm mới" class="btn-submit" />
        </div>
    }
</div>

<div style="margin-top: 25px; text-align: center;">
    @Html.ActionLink("Quay lại Danh sách", "Index_65133958", null, new { @class = "btn-back" })
</div>

<style>
    .btn-back {
        color: var(--primary);
        text-decoration: none;
        font-weight: 500;
    }

        .btn-back:hover {
            text-decoration: underline;
        }
</style>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}