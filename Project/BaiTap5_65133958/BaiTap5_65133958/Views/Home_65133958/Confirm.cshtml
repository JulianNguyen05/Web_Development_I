@{
    ViewBag.Title = "Xác nhận đăng ký";
    Layout = "~/Views/Shared/_LayoutAdmin_65133958.cshtml";
}

<h3>THÔNG TIN THÀNH VIÊN ĐÃ ĐĂNG KÝ</h3>

<table cellpadding="10">
    <tr>
        <td valign="top">
            <img src="@ViewBag.Avatar" width="150" alt="Ảnh đại diện" />
        </td>
        <td valign="top">
            <p><strong>Mã nhân viên:</strong> @ViewBag.EmpID</p>
            <p><strong>Họ tên:</strong> @ViewBag.Name</p>
            <p><strong>Ngày sinh:</strong> @ViewBag.BirthOfDate</p>
            <p><strong>Email:</strong> @ViewBag.Email</p>
            <p><strong>Mật khẩu:</strong> @ViewBag.Password</p>
            <p><strong>Phòng ban:</strong> @ViewBag.Department</p>
            <br />
            @Html.ActionLink("Quay lại", "Register")
        </td>
    </tr>
</table>