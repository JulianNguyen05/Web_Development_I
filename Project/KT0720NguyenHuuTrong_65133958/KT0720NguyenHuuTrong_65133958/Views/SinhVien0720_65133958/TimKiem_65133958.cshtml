@* SỬA 1: Đổi model thành HOCVIEN *@
@model PagedList.IPagedList<ThiGK65CNTTCLC_65133958.Models.HOCVIEN>
@using PagedList.Mvc;
@{
    @* SỬA 2: Đổi Title *@
    ViewBag.Title = "Tìm kiếm Học viên";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    // Lấy số thứ tự đầu tiên của trang
    int stt = Model.FirstItemOnPage;
}

<style>
    /* CSS cho thẻ Form tìm kiếm */
    .search-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: var(--shadow);
        padding: 25px;
        margin-bottom: 25px;
        margin-top: 20px;
        /* Thêm margin-top để không dính topbar */
    }
    /* CSS cho form */
    .search-form {
        display: flex;
        align-items: center;
        gap: 15px;
        flex-wrap: wrap;
    }

        .search-form label {
            font-weight: 600;
            margin: 0;
        }

        .search-form .form-control {
            width: 200px;
            padding: 8px 12px;
            border: 1px solid #ccc;
            border-radius: 6px;
        }

    .btn-search {
        background: var(--primary);
        color: #fff;
        padding: 9px 20px;
        border: none;
        border-radius: 8px;
        font-size: 1rem;
        cursor: pointer;
    }

    .btn-reset {
        background: #6c757d;
        color: #fff;
        padding: 9px 20px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 1rem;
    }

        .btn-reset:hover {
            color: #fff;
            background: #5a6268;
        }

    /* CSS cho thông báo "Không tìm thấy" */
    .search-message {
        text-align: center;
        font-size: 1.2rem;
        font-weight: 500;
        color: #e74a3b;
        padding: 20px 0;
    }

    /* CSS cho bảng kết quả (copy từ Index) */
    .table-wrapper {
        background: #fff;
        border-radius: 12px;
        box-shadow: var(--shadow);
        padding: 25px;
        overflow-x: auto;
    }

    .table-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

        .table-header h2 {
            margin: 0;
            color: var(--bg-dark);
        }

    .styled-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.95rem;
    }

        .styled-table thead th {
            background: #f5f7fa;
            color: #555;
            font-weight: 600;
            text-align: left;
            padding: 15px 12px;
            border-bottom: 2px solid #eee;
        }

        .styled-table tbody tr {
            border-bottom: 1px solid #f0f0f0;
        }

            .styled-table tbody tr:last-child {
                border-bottom: none;
            }

        .styled-table tbody td {
            padding: 15px 12px;
            vertical-align: middle;
        }

    /* SỬA LẠI: CSS cho các nút Chức năng (Sửa, Chi tiết, Xóa) */
    .btn-action {
        color: #fff;
        padding: 6px 12px;
        border-radius: 6px;
        text-decoration: none;
        font-size: 0.9rem;
        margin-right: 5px; /* Thêm khoảng cách */
        white-space: nowrap; /* Chống vỡ dòng */
    }

    .btn-details {
        background: #28a745; /* Green */
        color: #fff;
    }

        .btn-details:hover {
            background: #218838;
            color: #fff;
        }

    .btn-edit {
        background: #ffc107; /* Yellow */
        color: #212529; /* Màu chữ tối cho dễ đọc */
    }

        .btn-edit:hover {
            background: #e0a800;
            color: #212529;
        }

    .btn-delete {
        background: #dc3545; /* Red */
        color: #fff;
    }

        .btn-delete:hover {
            background: #c82333;
            color: #fff;
        }

    /* CSS cho phân trang */
    .pagination-container {
        display: flex;
        justify-content: center;
        align-items: center;
        margin-top: 25px;
    }

        .pagination-container .pagination {
            display: flex;
            list-style: none;
            padding: 0;
        }

            .pagination-container .pagination li {
                margin: 0 3px;
            }

                .pagination-container .pagination li a, .pagination-container .pagination li span {
                    display: block;
                    padding: 8px 14px;
                    border: 1px solid #ddd;
                    border-radius: 6px;
                    color: var(--primary);
                    text-decoration: none;
                }

                .pagination-container .pagination li.active span {
                    background: var(--primary);
                    color: #fff;
                    border-color: var(--primary);
                }
</style>

<div class="search-card">
    @* SỬA 3: Đổi controller và các trường tìm kiếm *@
    @using (Html.BeginForm("TimKiem_65133958", "HOCVIENs_65133958", FormMethod.Get, new { @class = "search-form" }))
    {
        <label for="maHV">Mã học viên:</label>
        <input type="text" name="maHV" id="maHV" value="@ViewBag.MaHVSearch" class="form-control" />

        <label for="tenHV">Họ tên:</label>
        <input type="text" name="tenHV" id="tenHV" value="@ViewBag.TenHVSearch" class="form-control" />

        <input type="submit" value="Tìm kiếm" class="btn-search" />

        @* SỬA 4: Đổi controller cho nút Reset *@
        @Html.ActionLink("Nhập mới", "TimKiem_65133958", "HOCVIENs_65133958", null, new { @class = "btn-reset" })
    }
</div>

<div class="table-wrapper">
    <div class="table-header">
        @* SỬA 5: Đổi tiêu đề H2 *@
        <h2>DANH SÁCH HỌC VIÊN</h2>
    </div>

    @if (ViewBag.Message != null)
    {
        <div class="search-message">
            @ViewBag.Message
        </div>
    }

    <table class="styled-table">
        <thead>
            @* SỬA 6: Đổi các tiêu đề cột *@
            <tr>
                <th>STT</th>
                <th>Mã học viên</th>
                <th>Họ học viên</th>
                <th>Tên học viên</th>
                <th>Giới tính</th>
                <th>Ngày sinh</th>
                <th>Ảnh HV</th>
                <th>Địa chỉ</th>
                <th>Tên đối tượng</th>
                <th>Chức năng</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@(stt++)</td>
                    @* SỬA 7: Đổi các properties *@
                    <td>@Html.DisplayFor(modelItem => item.MaHV)</td>
                    <td>@Html.DisplayFor(modelItem => item.HoHV)</td>
                    <td>@Html.DisplayFor(modelItem => item.TenHV)</td>
                    <td>
                        @(item.GioiTinh == true ? "Nam" : "Nữ")
                    </td>
                    <td>
                        @(item.NgaySinh.HasValue ? item.NgaySinh.Value.ToString("dd/MM/yyyy") : "")
                    </td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.AnhSV))
                        {
                            <img src="@Url.Content("~/Uploads/Images/" + item.AnhSV)"
                                 alt="Ảnh HV"
                                 style="width: 100px; height: auto; border-radius: 8px; object-fit: cover;" />
                        }
                        else
                        {
                            <span>(Không có ảnh)</span>
                        }
                    </td>
                    <td>@Html.DisplayFor(modelItem => item.DiaChi)</td>
                    @* SỬA 8: Đổi sang DOITUONG *@
                    <td>@Html.DisplayFor(modelItem => item.DOITUONG.TenDoiTuong)</td>

                    @* SỬA 9: Cập nhật các nút chức năng *@
                    <td>
                        @Html.ActionLink("Sửa", "Edit_65133958", new { id = item.MaHV }, new { @class = "btn-action btn-edit" })
                        @Html.ActionLink("Chi tiết", "Details_65133958", new { id = item.MaHV }, new { @class = "btn-action btn-details" })
                        @Html.ActionLink("Xóa", "Delete_65133958", new { id = item.MaHV }, new { @class = "btn-action btn-delete" })
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="pagination-container">
        @* SỬA 10: Cập nhật Pager để truyền đúng tham số tìm kiếm *@
        @Html.PagedListPager(Model, page => Url.Action("TimKiem_65133958",
            new { page, maHV = ViewBag.MaHVSearch, tenHV = ViewBag.TenHVSearch }),
            new PagedListRenderOptions
            {
                LiElementClasses = new[] { "page-item" },
                DisplayPageCountAndCurrentLocation = false,
                DisplayEllipsesWhenNotShowingAllPageNumbers = false
            })
    </div>
</div>