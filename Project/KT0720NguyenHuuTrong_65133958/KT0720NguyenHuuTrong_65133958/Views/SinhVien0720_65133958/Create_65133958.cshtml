@model KT0720NguyenHuuTrong_65133958.Models.SINHVIEN

@{
    ViewBag.Title = "Thêm mới Sinh viên";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    /* Thẻ Form */
    .form-card {
        background: #ffffff;
        border-radius: 12px;
        box-shadow: var(--shadow);
        padding: 30px;
        border-top: 5px solid var(--primary);
        max-width: 800px;
        margin: 20px auto; /* Thêm margin top để không dính vào topbar */
    }

        .form-card h2 {
            text-align: center;
            color: var(--bg-dark);
            margin-bottom: 30px;
            font-weight: 600;
        }

    /* Layout cho các dòng trong form (thay thế form-horizontal) */
    .form-row {
        display: grid;
        /* Nhãn 150px (căn phải) | Input (tự dãn) */
        grid-template-columns: 150px 1fr;
        gap: 15px; /* Khoảng cách giữa nhãn và input */
        align-items: center;
        margin-bottom: 20px;
    }

    .form-label {
        font-weight: 600;
        color: #555;
        text-align: right; /* Giống trong hình */
    }

    /* CSS cho các input, select */
    .form-control {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid #ccc;
        border-radius: 6px;
        font-size: 1rem;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .form-control:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(78, 115, 223, 0.25);
            outline: none;
        }

    /* CSS cho Radio Button (Giới tính) */
    .radio-group {
        display: flex;
        gap: 25px;
        align-items: center;
    }

        .radio-group label {
            font-weight: 500;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .radio-group input[type="radio"] {
            width: 16px;
            height: 16px;
        }

    /* CSS cho nút Submit */
    .submit-row {
        /* Cho phép nút submit chiếm trọn 2 cột */
        grid-column: 1 / -1;
        text-align: center;
        margin-top: 20px;
    }

    .btn-submit {
        background: var(--primary);
        color: #fff;
        padding: 12px 30px;
        border: none;
        border-radius: 8px;
        font-size: 1.1rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.3s ease;
    }

        .btn-submit:hover {
            background: var(--primary-hover);
        }

    /* Hiển thị lỗi validation */
    .text-danger {
        color: #e74a3b;
        font-size: 0.9rem;
        grid-column: 2 / -1; /* Hiển thị lỗi bên dưới input */
        margin-top: -15px;
        margin-bottom: 5px;
    }
</style>

<div class="form-card">
    <h2>NHẬP THÔNG TIN SINH VIÊN</h2>

    @* SỬA LỖI 1: Trỏ đến Action "Create_65133958" *@
    @using (Html.BeginForm("Create_65133958", "SinhVien0720_65133958", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()

        <div class="form-row">
            @Html.LabelFor(model => model.MaSV, "Mã sinh viên", new { @class = "form-label" })
            @Html.EditorFor(model => model.MaSV, new { htmlAttributes = new { @class = "form-control" } })
        </div>
        @Html.ValidationMessageFor(model => model.MaSV, "", new { @class = "text-danger" })

        <div class="form-row">
            @Html.LabelFor(model => model.HoSV, "Họ sinh viên", new { @class = "form-label" })
            @Html.EditorFor(model => model.HoSV, new { htmlAttributes = new { @class = "form-control" } })
        </div>
        @Html.ValidationMessageFor(model => model.HoSV, "", new { @class = "text-danger" })

        <div class="form-row">
            @Html.LabelFor(model => model.TenSV, "Tên sinh viên", new { @class = "form-label" })
            @Html.EditorFor(model => model.TenSV, new { htmlAttributes = new { @class = "form-control" } })
        </div>
        @Html.ValidationMessageFor(model => model.TenSV, "", new { @class = "text-danger" })

        <div class="form-row">
            @Html.LabelFor(model => model.NgaySinh, "Ngày sinh", new { @class = "form-label" })
            @Html.EditorFor(model => model.NgaySinh, new { htmlAttributes = new { @class = "form-control", @type = "date" } })
        </div>
        @Html.ValidationMessageFor(model => model.NgaySinh, "", new { @class = "text-danger" })

        <div class="form-row">
            @Html.LabelFor(model => model.GioiTinh, "Giới tính", new { @class = "form-label" })
            <div class="radio-group">
                <label>
                    @Html.RadioButtonFor(model => model.GioiTinh, "true", new { @checked = "checked" })
                    <span>Nam</span>
                </label>
                <label>
                    @Html.RadioButtonFor(model => model.GioiTinh, "false")
                    <span>Nữ</span>
                </label>
            </div>
        </div>

        <div class="form-row">
            <label class="form-label" for="AnhUpload">Ảnh sinh viên</label>
            <input type="file" name="AnhUpload" id="AnhUpload" class="form-control" />
        </div>
        @Html.ValidationMessageFor(model => model.AnhSV, "", new { @class = "text-danger" })

        <div class="form-row">
            @Html.LabelFor(model => model.DiaChi, "Địa chỉ", new { @class = "form-label" })
            @Html.EditorFor(model => model.DiaChi, new { htmlAttributes = new { @class = "form-control" } })
        </div>
        @Html.ValidationMessageFor(model => model.DiaChi, "", new { @class = "text-danger" })

        <div class="form-row">
            @Html.LabelFor(model => model.MaLop, "Mã lớp", new { @class = "form-label" })
            @Html.DropDownList("MaLop", null, "--- Chọn lớp ---", htmlAttributes: new { @class = "form-control" })
        </div>
        @Html.ValidationMessageFor(model => model.MaLop, "", new { @class = "text-danger" })

        <div class="form-row submit-row">
            <input type="submit" value="Thêm mới" class="btn-submit" />
        </div>
    }
</div>

<div style="margin-top: 25px; text-align: center;">
    @* SỬA LỖI 2: Trỏ đến Action "Index_65133958" *@
    @Html.ActionLink("Quay lại Danh sách", "Index_65133958", null, new { @class = "btn-back" })
</div>

<style>
    .btn-back {
        color: var(--primary);
        text-decoration: none;
        font-weight: 500;
    }

        .btn-back:hover {
            text-decoration: underline;
        }
</style>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}